# Connexion a la base. En production, la variable vient de l'hebergeur.
DATABASE_URL="postgresql://user:motdepasse@hote:5432/quotator?schema=public"

# Secret de signature des sessions. Au moins 32 caracteres, propre a chaque
# environnement : le changer deconnecte tout le monde, ce qui est le
# comportement voulu en cas de fuite.
#   openssl rand -base64 48
AUTH_SECRET=""

# Adresse publique de l'application, utilisee pour composer les liens de
# connexion et les liens de devis envoyes aux clients.
APP_URL="https://app.madcityzen.fr"

# Expedition des courriers. Tant que ces variables sont incompletes, les
# messages sont ecrits dans le dossier .courrier au lieu d'etre envoyes :
# un environnement de recette n'ecrit jamais a un vrai client par accident.
SMTP_HOTE=""
SMTP_PORT="587"
SMTP_UTILISATEUR=""
SMTP_MOT_DE_PASSE=""
COURRIER_EXPEDITEUR="MadCityZen <devis@madcityzen.fr>"
COURRIER_REPONDRE_A=""
